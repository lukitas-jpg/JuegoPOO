  + finalizarEtapaDeCombate(resultado : ResultadoCombate) : void
  + finalizarEtapaDeTienda() : void
  - avanzarYGuardar() : void
  + guardarAutomaticamente() : void
  + finalizarPorDerrota() : void
  + getEstadoPartida() : EstadoPartida
  + getPartida() : Partida
  - generarEtapaActual() : void
  - getClasesDeLaParty() : List<ClaseDePersonaje>
  + {static} crearPersonaje(clase : ClaseDePersonaje) : Personaje
  .. combate ..
  + iniciarCombate() : Combate
  .. tienda ..
  + getTienda() : Tienda
  + puedeComprarEquipable(indiceSlot : int, destinatario : Personaje) : boolean
  + comprarEquipable(indiceSlot : int, destinatario : Personaje) : Equipable
  + comprarConsumible(indiceEnElCatalogo : int) : boolean
  + rerollearTienda() : boolean
  + usarConsumibleFueraDeCombate(consumible : Consumible, objetivo : Personaje) : boolean
