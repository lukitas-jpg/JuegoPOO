@startuml 4_combate_partida
title TPO POO - RPG por turnos\nDiagrama 4: Motor de combate, Partida, Etapas y Persistencia

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
hide empty members

enum TipoEtapa {
  NORMAL
  MINIJEFE
  JEFE_FINAL
}

enum EstadoPartida {
  EN_CURSO
  GANADA
  PERDIDA
}

