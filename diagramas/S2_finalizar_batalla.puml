@startuml S2_finalizar_batalla
title TPO POO - RPG por turnos\nSecuencia 2: Finalizar la batalla (recompensas, subida de nivel, limpieza y guardado)

skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 10

participant "controlador : ControladorCombate" as CC
participant "combate : Combate" as CO
participant "juego : Juego" as C
participant "etapa : EtapaDeCombate" as ET
participant "party : Party" as P
participant "guerrero : Guerrero" as PE
participant "veneno : Veneno" as V
participant "buff : BuffEstadistica" as B
participant "partida : Partida" as PA
participant "generador : GeneradorDeEtapas" as GE
participant "repo : RepositorioPartidas" as RE
participant "vista : VistaDelJuego" as VI

== 1. Fin del combate ==

CC -> CO : hayGanador()
activate CO
CO --> CC : true
deactivate CO

note over CC
  Combate detecta el fin, pero no cierra la etapa:
  no conoce ni la Partida ni el repositorio. Lo
  cierra Juego, que es quien coordina la sesion.
end note

CC -> CO : calcularResultado()
activate CO
note right of CO
  Las recompensas las define la ETAPA COMPLETA, no
  cada enemigo: EtapaDeCombate.crearCombate() se las
  paso a Combate al crearlo.
end note
create participant "res : ResultadoCombate" as RC
CO -> RC : <<create>> (victoria, exp, oro, registro)
CO --> CC : res
deactivate CO

== 2. Cierre de la etapa ==

CC -> C : finalizarEtapaDeCombate(resultado : ResultadoCombate)
activate C

note over C
  GRASP Controller del MODELO: recibe el evento de
  fin de etapa y coordina delegando. Para las tiendas
  existe el metodo hermano finalizarEtapaDeTienda(),
  que no reparte nada.
end note

C -> RC : fueVictoria()
activate RC
RC --> C : victoria : boolean
deactivate RC

alt la party fue derrotada
  C -> C : finalizarPorDerrota()
  activate C
  C -> PA : terminarPorDerrota()
  activate PA
  note right of PA
    estado = PERDIDA. Es un roguelike: el guardado
    se borra para que no se pueda recargar y
    deshacer la derrota.
  end note
  deactivate PA
  C -> RE : borrar()
  activate RE
  deactivate RE
  deactivate C

else hubo victoria

== 3. Reparto de recompensas ==

C -> ET : otorgaExperiencia()
activate ET
ET --> C : true
deactivate ET
note right of ET
  Polymorphism: Juego no pregunta de que tipo es
  la etapa. Una EtapaDeTienda responderia false.
end note

C -> RC : getExperienciaGanada()
activate RC
RC --> C : exp
deactivate RC

C -> P : repartirExperiencia(cantidad : int)
activate P
loop para cada miembro de la party
  P -> PE : estaVivo()
  activate PE
  PE --> P : true
  deactivate PE
  note right of P
    Information Expert: la Party sabe que un
    caido cobra la mitad, y cada Personaje
    decide solo si sube de nivel.
  end note
  P -> PE : ganarExperiencia(cantidad : int)
  activate PE
  loop mientras experienciaActual >= experienciaParaSubir
    PE -> PE : subirNivel()
    activate PE
    PE -> PE : aplicarCrecimientoPorNivel()
    note right of PE
      Autollamada polimorfica: cada clase tiene su
      curva de crecimiento. El desbloqueo de
      movimientos no se guarda: estaDesbloqueado()
      compara niveles cada vez que se consulta.
    end note
    deactivate PE
  end
  PE --> P : niveles subidos
  deactivate PE
end
deactivate P

C -> RC : getOroGanado()
activate RC
RC --> C : oro
deactivate RC
C -> P : agregarOro(cantidad : int)
activate P
deactivate P

== 4. Limpieza de efectos temporales ==

C -> P : limpiarEfectosTemporales()
activate P
loop para cada miembro de la party
  P -> PE : limpiarEfectosTemporales()
  activate PE
  PE -> V : persisteFueraDeCombate()
  activate V
  V --> PE : true
  deactivate V
  note right of V
    El veneno persiste: se arrastra a la etapa
    siguiente.
  end note
  PE -> B : persisteFueraDeCombate()
  activate B
  B --> PE : false
  deactivate B
  destroy B
  note right of PE
    Los que no persisten se sacan de la lista y
    listo: no hay nada que revertir, porque las
    estadisticas efectivas se calculan en el
    momento sumando los efectos activos.
  end note
  deactivate PE
end
deactivate P

== 5. Avance de etapa y guardado automatico ==

C -> C : avanzarYGuardar()
activate C
C -> ET : marcarCompletada()
activate ET
deactivate ET
C -> PA : avanzarEtapa()
activate PA
deactivate PA
C -> PA : estaEnCurso()
activate PA
PA --> C : enCurso : boolean
deactivate PA

alt la partida sigue en curso
  C -> C : generarEtapaActual()
  activate C
  C -> GE : crearEtapa(numero : int, clases : List<ClaseDePersonaje>)
  activate GE
  GE --> C : etapa siguiente
  deactivate GE
  deactivate C
  C -> C : guardarAutomaticamente()
  activate C
  C -> RE : guardar(partida : Partida)
  activate RE
  note right of RE
    Protected Variations: Juego habla con la
    INTERFAZ, nunca con RepositorioPartidasArchivo.
  end note
  deactivate RE
  deactivate C
else se supero la etapa 20
  C -> RE : borrar()
  activate RE
  note right of RE
    estado = GANADA: la run termino bien y no
    queda nada que retomar.
  end note
  deactivate RE
end
deactivate C
end
deactivate C

== 6. La vista muestra el resultado ==

CC -> VI : mostrarResultado(resultado : ResultadoDTO)
activate VI
note right of VI
  El controlador arma el ResultadoDTO (victoria,
  experiencia, oro, si la run termino y como quedo
  la party). VentanaPrincipal implementa esta
  interfaz y muestra la pantalla de resultado.
end note
deactivate VI

@enduml
