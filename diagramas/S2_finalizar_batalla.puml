@startuml S2_finalizar_batalla
title TPO POO - RPG por turnos\nSecuencia 2: Finalizar la batalla (recompensas, subida de nivel, limpieza y guardado)\n(solo clases del modelo: la interfaz y su capa de control son alcance de la Fase B)

skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 12

actor Jugador as J
participant "juego : Juego" as C
participant "combate : Combate" as CO
participant "etapa : EtapaDeCombate" as ET
participant "party : Party" as P
participant "guerrero : Personaje" as PE
participant "veneno : Veneno" as V
participant "buff : BuffEstadistica" as B
participant "partida : Partida" as PA
participant "repo : RepositorioPartidas" as RE

== 1. Fin del combate ==

J -> CO : hayGanador()
activate CO
CO --> J : true
deactivate CO

note over J
  QUIÉN INICIA ESTE FLUJO: el actor es quien venía
  conduciendo el bucle de combate pidiendo los turnos
  (en la Fase B, el controlador de la pantalla de
  batalla). Al resolverse una acción consulta
  hayGanador(); cuando da true, el combate terminó y
  recién ahí entra Juego.

  Combate detecta el fin, pero no se cierra la etapa a
  sí mismo: no conoce ni la Partida ni el repositorio.
end note

J -> CO : calcularResultado()
activate CO
CO -> ET : getExperienciaBase()
activate ET
ET --> CO : exp
deactivate ET
CO -> ET : getOroBase()
activate ET
ET --> CO : oro
deactivate ET
note right of CO
  Las recompensas las define la ETAPA COMPLETA, no
  cada enemigo. Por eso Enemigo no tiene
  experienciaOtorgada ni oroOtorgado: si las tuviera,
  el Nigromante seria una granja infinita de
  experiencia, porque repone esqueletos cada 3 rondas.
end note
create participant "res : ResultadoCombate" as RC
CO -> RC : <<create>> (victoria, exp, oro)
CO --> J : res
deactivate CO

== 2. Cierre de la etapa ==

J -> C : finalizarEtapaDeCombate(resultado : ResultadoCombate)
activate C

note over C
  GRASP Controller: Juego recibe el evento de fin de
  etapa y coordina delegando. Es una clase del MODELO,
  no de la interfaz.

  La firma coincide con el diagrama de clases: Juego
  recibe el ResultadoCombate ya armado, no sale a
  buscarlo. Para las etapas de tienda existe el método
  hermano finalizarEtapaDeTienda(), que no reparte
  recompensas.
end note

C -> RC : fueVictoria()
activate RC
RC --> C : victoria : boolean
deactivate RC

alt la party fue derrotada
  C -> PA : terminarPorDerrota()
  activate PA
  note right of PA
    estado = PERDIDA. Es un roguelike:
    la partida guardada se borra para que
    no se pueda recargar y deshacer la
    derrota.
  end note
  deactivate PA
  C -> RE : borrar()
  activate RE
  deactivate RE
  C --> J : fin de la run (derrota)

else hubo victoria

== 3. Reparto de recompensas ==

C -> RC : getOroGanado()
activate RC
RC --> C : oro
deactivate RC

C -> P : agregarOro(cantidad : int)
activate P
deactivate P

C -> ET : otorgaExperiencia()
activate ET
ET --> C : true
deactivate ET

note right of ET
  Polymorphism: Juego no pregunta de que
  tipo es la etapa. Una EtapaDeTienda
  respondería false y no se repartiría
  experiencia.
end note

C -> RC : getExperienciaGanada()
activate RC
RC --> C : exp
deactivate RC

C -> P : repartirExperiencia(cantidad : int)
activate P

note right of P
  Information Expert: Juego no calcula nada.
  La Party reparte y cada Personaje decide
  solo si le alcanza para subir de nivel.
end note

loop para cada miembro de la party
  P -> PE : ganarExperiencia(cantidad : int)
  activate PE

  loop mientras experienciaActual >= experienciaParaSubir
    PE -> PE : subirNivel()
    activate PE
    PE -> PE : aplicarCrecimientoPorNivel()
    note right of PE
      Autollamada polimórfica: cada clase de
      personaje (Guerrero, Mago, Arquero...)
      tiene su propia curva de crecimiento.
    end note
    deactivate PE

    note right of PE
      El desbloqueo de movimientos NO es un
      estado que se guarde: es DERIVADO.
      Movimiento.estaDesbloqueado(personaje)
      compara nivelDesbloqueo con el nivel
      actual cada vez que se consulta, así que
      al subir de nivel no hay nada que marcar.
    end note
  end

  deactivate PE
end

P --> C : ok
deactivate P

== 4. Limpieza de efectos temporales ==

C -> P : limpiarEfectosTemporales()
activate P

loop para cada miembro de la party
  P -> PE : limpiarEfectosTemporales()
  activate PE

  loop para cada efecto activo
    PE -> V : persisteFueraDeCombate()
    activate V
    V --> PE : true
    deactivate V
    note right of PE
      El veneno persiste: se arrastra a la
      etapa siguiente y NO se le vuelve a
      llamar alAplicarse().
    end note

    PE -> B : persisteFueraDeCombate()
    activate B
    B --> PE : false
    deactivate B

    alt no persiste
      PE -> B : alExpirar(objetivo : Combatiente)
      activate B
      note right of B
        Devuelve la estadística a su valor
        original. Si no se llamara, el buff
        quedaría inflado para siempre.
      end note
      deactivate B
      destroy B
    end
  end

  deactivate PE
end

P --> C : ok
deactivate P

== 5. Avance de etapa y guardado automático ==

C -> PA : avanzarEtapa()
activate PA
PA --> C : ok
deactivate PA

C -> PA : estaEnCurso()
activate PA
PA --> C : enCurso : boolean
deactivate PA

note right of PA
  avanzarEtapa() detecta solo el fin por
  victoria: si numeroEtapaActual pasa de 20,
  el estado cambia a GANADA y no hay nada
  más que guardar.
end note

alt la partida sigue en curso
  C -> RE : guardar(partida : Partida)
  activate RE
  note right of RE
    Protected Variations: Juego habla con la
    INTERFAZ, nunca con
    RepositorioPartidasArchivo. Cambiar a JSON
    o base de datos no toca esta secuencia.
  end note
  RE --> C : ok
  deactivate RE
  C --> J : etapa siguiente

else la run se ganó (se superó la etapa 20)
  note right of C
    estado = GANADA. No hay etapa siguiente ni
    nada que guardar: la run terminó bien. El
    mensaje de retorno es distinto al del caso
    normal, igual que en la rama de derrota.
  end note
  C --> J : fin de la run (victoria total)
end
end
deactivate C

@enduml
