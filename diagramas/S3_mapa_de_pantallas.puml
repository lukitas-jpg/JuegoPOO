@startuml S3_mapa_de_pantallas
title TPO POO - RPG por turnos\nMapa de pantallas y transiciones

skinparam state {
  BackgroundColor #f5f5f5
  BorderColor #555555
  FontSize 13
}
skinparam ArrowFontSize 11
skinparam nodesep 35
skinparam ranksep 45

[*] -down-> MenuPrincipal

state MenuPrincipal {
  MenuPrincipal : Nueva partida
  MenuPrincipal : Continuar (solo si hay guardado)
  MenuPrincipal : Salir
}

state SeleccionDeParty {
  SeleccionDeParty : elegir 3 de las 6 clases
  SeleccionDeParty : muestra estadisticas y los 4 movimientos
}

state Combate {
  Combate : el grueso del juego
  Combate : turno del jugador: atacar / defender / item
  Combate : turnos de enemigo automaticos con Timer
}

state ResumenDeEtapa {
  ResumenDeEtapa : experiencia y oro ganados
  ResumenDeEtapa : subidas de nivel
}

state Tienda {
  Tienda : catalogo fijo de 5 consumibles
  Tienda : 3 slots rotativos + boton de reroll
}

state MaquinaDeSlots {
  MaquinaDeSlots : primera tirada gratis
  MaquinaDeSlots : se abandona al pasar, sin vuelta
}

MenuPrincipal -down-> SeleccionDeParty : Nueva partida
MenuPrincipal -right-> Combate : Continuar\n(etapa de combate)
MenuPrincipal -right-> Tienda : Continuar\n(etapa de tienda)
MenuPrincipal -down-> [*] : Salir

SeleccionDeParty -right-> Combate : confirmar party\n(etapa 1)
SeleccionDeParty -up-> MenuPrincipal : volver

Combate -down-> ResumenDeEtapa : cae el ultimo enemigo
Combate -right-> Derrota : cae toda la party

ResumenDeEtapa -up-> Combate : etapas 1-3, 5-8,\n10-13, 15-18, 20
ResumenDeEtapa -down-> Tienda : etapas 4 y 14
ResumenDeEtapa -down-> MaquinaDeSlots : etapas 9 y 19
ResumenDeEtapa -right-> Victoria : se completo la etapa 20

MaquinaDeSlots -right-> Tienda : apostar o pasar

Tienda -up-> Combate : siguiente etapa

Derrota -down-> MenuPrincipal : volver al menu
Victoria -down-> MenuPrincipal : volver al menu

Derrota -down-> [*]
Victoria -down-> [*]

state Inventario <<choice>>
Combate -up-> Inventario : abrir inventario
Inventario -down-> Combate : usar un consumible\no cerrar

note right of Inventario
  Es un dialogo modal sobre la
  pantalla de combate, no una
  pantalla aparte. Usar un
  consumible gasta el turno.
end note

note right of MaquinaDeSlots
  Aparece ANTES de la tienda y solo
  en las etapas 9 y 19. Una vez que
  el jugador pasa a la tienda, la
  maquina queda abandonada y no se
  puede volver.
end note

note bottom of Combate
  Todo esto vive en un solo JFrame con
  CardLayout: cada pantalla es un JPanel
  y se intercambian. No hay ventanas
  sueltas, salvo el dialogo de inventario
  y las alertas de descarte.
end note

note bottom of Derrota
  La muerte es permanente: al perder se
  borra el guardado y no se puede retomar.
  La unica forma de revivir a alguien es
  el Polvo de Renacer, y hay que usarlo
  antes de que caiga el ultimo.
end note

@enduml
